{include file="$template/header.tpl"}
<div class="page-hero" style="padding-top:18px"><span class="eyebrow">Create your account</span><h1 class="gradient-text">Join Solaris Hosting.</h1><p>Create a customer account to order services, manage domains, and receive support.</p></div>
<div class="card" style="max-width:760px;margin:0 auto"><form method="post" action="{$smarty.server.PHP_SELF}"><input type="hidden" name="register" value="true"><div class="form-grid"><div class="field"><label>First Name</label><input type="text" name="firstname" value="{$clientfirstname}" required></div><div class="field"><label>Last Name</label><input type="text" name="lastname" value="{$clientlastname}" required></div><div class="field"><label>Email</label><input type="email" name="email" value="{$clientemail}" required></div><div class="field"><label>Phone</label><input type="tel" name="phonenumber" value="{$clientphonenumber}"></div><div class="field full"><label>Address</label><input type="text" name="address1" value="{$clientaddress1}"></div><div class="field"><label>City</label><input type="text" name="city" value="{$clientcity}"></div><div class="field"><label>State</label><input type="text" name="state" value="{$clientstate}"></div><div class="field"><label>Postcode</label><input type="text" name="postcode" value="{$clientpostcode}"></div><div class="field"><label>Country</label>{$clientcountriesdropdown}</div><div class="field"><label>Password</label><input type="password" name="password" required></div><div class="field"><label>Confirm Password</label><input type="password" name="password2" required></div><div class="field full"><button class="btn btn-primary" type="submit">Create Account</button></div></div></form></div>
{include file="$template/footer.tpl"}